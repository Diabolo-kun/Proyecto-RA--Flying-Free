# Unity gitignore configurado para proyectos en la raíz o en subcarpetas (ej. Unity/FlyingFree/)
# Excluye todos los archivos generados y temporales que aumentan el peso innecesariamente.

# ==========================================
# Carpetas temporales y generadas por Unity
# ==========================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/
.gradle/
ExportedObj/
UIElementsSchema/

# Archivos de log y volcados de fallos
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# ==========================================
# Archivos de respaldo de diseño 3D
# ==========================================
# Copias de seguridad de Blender no necesarias en el repositorio
*.blend1
*.blend1.meta

# ==========================================
# Proyectos y cachés de IDEs / Editores
# ==========================================
# Visual Studio / Visual Studio Code
.vs/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider / IntelliJ
.idea/
*.DotSettings.user
**/Assets/Plugins/Editor/JetBrains*

# Metadatos generados para archivos temporales
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ==========================================
# Compilaciones y paquetes de salida (Builds)
# ==========================================
*.apk
*.aab
*.app
*.ipa
*.exe

# ==========================================
# Addressables & Visual Scripting
# ==========================================
ServerData/
**/StreamingAssets/aa*
**/AddressableAssetsData/link.xml*
**/Addressables_Temp*
**/AddressableAssetsData/*/*.bin*
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
**/Assets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
**/Assets/SceneDependencyCache*
**/InitTestScene*.unity*

# ==========================================
# Animaciones pesadas de vídeo/cinemática (>100MB)
# ==========================================
*Video_Completo.anim
*Video_Completo.anim.meta
*Vida_Parque_Completa.anim
*Vida_Parque_Completa.anim.meta

# ==========================================
# Archivos del Sistema Operativo
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
